    "@vitejs/plugin-react": "^6.1.2",
    "iconv-lite": "^0.7.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
