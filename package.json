{
  "name": "open-eml",
  "private": true,
  "version": "0.1.0",
  "description": "브라우저에서 .eml 파일과 첨부파일을 열어 보고 내려받는 이메일 뷰어",
  "type": "module",
  "scripts": {
    "dev": "vite",
